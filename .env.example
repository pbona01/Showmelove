# Browser-safe values only. Never prefix secret keys with VITE_.
VITE_SUPABASE_URL=
# New Supabase key name (preferred). The legacy VITE_SUPABASE_ANON_KEY is still supported.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Server-only Vercel variables (do not add these to a .env file committed to git):
# SUPABASE_URL=             # same project URL, without VITE_ prefix
# SUPABASE_PUBLISHABLE_KEY= # same publishable browser-safe key
# SUPABASE_SECRET_KEY=      # Supabase secret key (sb_secret_...)
# PAYSTACK_SECRET_KEY=      # Paystack sk_test_... / sk_live_...
# PAYSTACK_WEBHOOK_SECRET=  # Optional dedicated signing secret; API secret is used for legacy Paystack webhooks
# PAYSTACK_CALLBACK_URL=https://showmelove.fun/payments/verify

